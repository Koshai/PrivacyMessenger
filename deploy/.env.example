# Copy to deploy/.env and replace every value before a real deployment.
# deploy/.env is gitignored. Do not commit passwords, OTP secrets, or the TURN secret.
# Placeholder hostnames below are not a real zone. Do not point them at the VPS
# until the owned domain and DNS change are explicitly approved.

APP_ENV=validation
APP_HOST=0.0.0.0
APP_PORT=4000

API_DOMAIN=api.example.com
ACME_EMAIL=ops@example.com
TURN_DOMAIN=turn.example.com

POSTGRES_USER=pm_admin
POSTGRES_PASSWORD=replaceWithAdminPassword
POSTGRES_APP_PASSWORD=replaceWithAppPassword
POSTGRES_DB=private_messenger
# sslmode=disable is for the private Docker network only. Do not publish port 5432.
# pool_max_conns keeps the API under PostgreSQL max_connections=30.
VALIDATION_DATABASE_URL=postgres://pm_app:replaceWithAppPassword@postgres:5432/private_messenger?sslmode=disable&pool_max_conns=8

# Base64, at least 32 decoded bytes. Generate a new value per environment.
OTP_HMAC_SECRET=replaceWithBase64SecretOfAtLeast32Bytes

# The sender requires STARTTLS and AUTH PLAIN. Use submission port 587, not implicit TLS on 465.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replaceWithSmtpUsername
SMTP_PASSWORD=replaceWithSmtpPassword
SMTP_FROM_EMAIL=otp@example.com
SMTP_FROM_NAME=PrivacyMessenger

# Alphanumeric, at least 16 characters. The API rejects a shorter secret.
# The same value is rendered into coturn. Never put it in the Flutter build.
TURN_SHARED_SECRET=replaceWithAlphanumericTurnSecret
TURN_REALM=turn.example.com
TURN_EXTERNAL_IP=203.0.113.10
TURN_URLS=turn:turn.example.com:3478?transport=udp
TURN_STUN_URLS=stun:turn.example.com:3478
TURN_TTL_SECONDS=600

# Browser origins only. Leave empty for the Flutter clients.
WS_ALLOWED_ORIGINS=
